{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "step_id": { "type": "string" },
    "step_name": { "type": "string" },
    "expected_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": { "type": "string" },
          "color": { "type": "string" },
          "position": { "type": "string", "enum": ["LEFT", "RIGHT", "TOP", "BOTTOM", "CENTER"] },
          "orientation": { "type": "string", "enum": ["VERTICAL", "HORIZONTAL"] }
        },
        "required": ["part_id", "color", "position", "orientation"]
      }
    }
  },
  "required": ["step_id", "step_name", "expected_parts"]
}